              <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white py-3 rounded-xl font-semibold transition-all shadow-lg hover:shadow-xl">Save Weight Entry</button>
            </form>
          </div>
          <div class="bg-gradient-to-br from-brand-500 to-brand-700 rounded-2xl p-6 shadow-lg text-white">
            <i data-lucide="lightbulb" class="w-8 h-8 mb-3 text-brand-200"></i>
            <h4 class="font-bold mb-1">Tip</h4>
            <p class="text-sm text-brand-100">Weigh yourself at the same time each day, preferably in the morning before eating, for the most consistent tracking.</p>
          </div>
        </div>
      </div>`;
    }

