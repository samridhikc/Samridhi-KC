<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fitness Hub - Your Complete Fitness Companion</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 50:'#ecfdf5',100:'#d1fae5',200:'#a7f3d0',300:'#6ee7b7',400:'#34d399',500:'#10b981',600:'#059669',700:'#047857',800:'#065f46',900:'#064e3b' },
            accent: { 400:'#fb923c',500:'#f97316',600:'#ea580c' }
          },
          fontFamily: { sans: ['Inter','sans-serif'] }
        }
      }
    }
  </script>
  <style>
    * { font-family: 'Inter', sans-serif; }
    ::selection { background: #059669; color: #fff; }
    .fade-in { animation: fadeIn 0.3s ease-in; }
    @keyframes fadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  </style>
</head>
<body class="bg-slate-50 min-h-screen">
  <div id="app"></div>

  <script>
    // ========================================
    // STATE MANAGEMENT
    // ========================================
    const state = {
      token: localStorage.getItem('fh_token'),
      user: JSON.parse(localStorage.getItem('fh_user') || 'null'),
      page: 'dashboard',
      data: {}
    };

    const API = 'http://localhost:5000/api';

    // ========================================
    // API HELPER - Talks to Backend Server
    // ========================================
    async function api(endpoint, method = 'GET', body = null) {
      const headers = { 'Content-Type': 'application/json' };
      if (state.token) headers['Authorization'] = `Bearer ${state.token}`;
      try {
        const res = await fetch(`${API}${endpoint}`, {
          method, headers,
          body: body ? JSON.stringify(body) : null
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'API Error');
        return data;
      } catch (err) {
        showToast(err.message, 'error');
        throw err;
      }
    }

    // ========================================
    // TOAST NOTIFICATION
    // ========================================
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      const bg = type === 'error' ? 'bg-red-500' : type === 'info' ? 'bg-blue-500' : 'bg-brand-600';
      const icon = type === 'error' ? 'x-circle' : type === 'info' ? 'info' : 'check-circle';
      toast.className = `fixed top-6 right-6 z-[999] ${bg} text-white px-6 py-3 rounded-lg shadow-2xl fade-in flex items-center gap-2`;
      toast.innerHTML = `<i data-lucide="${icon}" class="w-5 h-5"></i><span class="text-sm font-medium">${message}</span>`;
      document.body.appendChild(toast);
      lucide.createIcons({ nodes: [toast] });
      setTimeout(() => { toast.style.opacity='0'; toast.style.transition='opacity 0.3s'; setTimeout(()=>toast.remove(),300); }, 3000);
    }

    // ========================================
    // AUTH FUNCTIONS
    // ========================================
    function setAuth(token, user) {
      state.token = token;
      state.user = user;
      localStorage.setItem('fh_token', token);
      localStorage.setItem('fh_user', JSON.stringify(user));
    }

    function logout() {
      state.token = null;
      state.user = null;
      state.page = 'dashboard';
      state.data = {};
      localStorage.removeItem('fh_token');
      localStorage.removeItem('fh_user');
      render();
    }

    function navigate(page) {
      state.page = page;
      render();
    }

    // ========================================
    // MAIN RENDER
    // ========================================
    function render() {
      const app = document.getElementById('app');
      if (!state.token) {
        app.innerHTML = renderAuth();
      } else {
        app.innerHTML = renderApp();
      }
      lucide.createIcons();
      initCharts();
    }

    // ========================================
    // AUTH PAGE (Login / Register)
    // ========================================
    function renderAuth() {
      return `
      <div class="min-h-screen bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900 flex items-center justify-center p-4">
        <div class="max-w-md w-full">
          <div class="text-center mb-8 fade-in">
            <div class="inline-flex items-center gap-3 mb-4">
              <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-lg">
                <i data-lucide="dumbbell" class="w-8 h-8 text-brand-600"></i>
              </div>
              <h1 class="text-4xl font-bold text-white tracking-tight">Fitness Hub</h1>
            </div>
            <p class="text-brand-200 text-lg">Your complete fitness companion</p>
          </div>
          <div class="bg-white rounded-2xl shadow-2xl p-8 fade-in">
            <div class="flex bg-slate-100 rounded-xl p-1 mb-6">
              <button onclick="switchAuthTab('login')" id="tab-login"
                class="flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all bg-brand-600 text-white">Login</button>
              <button onclick="switchAuthTab('register')" id="tab-register"
                class="flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all text-slate-600">Register</button>
            </div>
            <form id="login-form" onsubmit="handleLogin(event)">
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                  <input type="email" id="login-email" required placeholder="you@example.com"
                    class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                  <input type="password" id="login-password" required placeholder="Enter password"
                    class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
                </div>
                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white py-3 rounded-xl font-semibold transition-all shadow-lg hover:shadow-xl">Sign In</button>
              </div>
            </form>
            <form id="register-form" class="hidden" onsubmit="handleRegister(event)">
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                  <input type="text" id="reg-name" required placeholder="Your full name"
                    class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                  <input type="email" id="reg-email" required placeholder="you@example.com"
                    class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                  <input type="password" id="reg-password" required minlength="6" placeholder="Min 6 characters"
                    class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
                </div>
                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white py-3 rounded-xl font-semibold transition-all shadow-lg hover:shadow-xl">Create Account</button>
              </div>
            </form>
            <p class="text-center text-xs text-slate-400 mt-6">Register with any email to get started</p>
          </div>
        </div>
      </div>`;
    }

    function switchAuthTab(tab) {
      const lf = document.getElementById('login-form');
      const rf = document.getElementById('register-form');
      const tl = document.getElementById('tab-login');
      const tr = document.getElementById('tab-register');
      if (tab === 'login') {
        lf.classList.remove('hidden'); rf.classList.add('hidden');
        tl.className='flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all bg-brand-600 text-white';
        tr.className='flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all text-slate-600';
      } else {
        lf.classList.add('hidden'); rf.classList.remove('hidden');
        tr.className='flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all bg-brand-600 text-white';
        tl.className='flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all text-slate-600';
      }
    }

    async function handleLogin(e) {
      e.preventDefault();
      try {
        const data = await api('/auth/login', 'POST', {
          email: document.getElementById('login-email').value,
          password: document.getElementById('login-password').value
        });
        setAuth(data.token, data.user);
        showToast('Welcome back!');
        render();
      } catch(err){}
    }

    async function handleRegister(e) {
      e.preventDefault();
      try {
        const data = await api('/auth/register', 'POST', {
          name: document.getElementById('reg-name').value,
          email: document.getElementById('reg-email').value,
          password: document.getElementById('reg-password').value
        });
        setAuth(data.token, data.user);
        showToast('Account created! Welcome to Fitness Hub!');
        render();
      } catch(err){}
    }

    // ========================================
    // MAIN APP LAYOUT (Sidebar + Content)
    // ========================================
    function renderApp() {
      const menuItems = [
        { id:'dashboard', icon:'layout-dashboard', label:'Dashboard' },
        { id:'profile', icon:'user-circle', label:'Profile' },
        { id:'calories', icon:'flame', label:'Calorie Tracker' },
        { id:'weight', icon:'trending-down', label:'Weight Tracker' },
        { id:'exercises', icon:'dumbbell', label:'Exercises' },
        { id:'subscription', icon:'crown', label:'Subscription' },
        { id:'trainer', icon:'message-circle', label:'Trainer Chat' },
      ];

      return `
      <div class="flex min-h-screen">
        <!-- Desktop Sidebar -->
        <aside class="hidden lg:flex flex-col w-64 bg-white border-r border-slate-100 shadow-sm fixed h-full z-40">
          <div class="p-6 border-b border-slate-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center">
                <i data-lucide="dumbbell" class="w-5 h-5 text-white"></i>
              </div>
              <span class="text-xl font-bold text-slate-900 tracking-tight">Fitness Hub</span>
            </div>
          </div>
          <nav class="flex-1 p-4 space-y-1">
            ${menuItems.map(item => `
              <button onclick="navigate('${item.id}')"
                class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all
                ${state.page===item.id ? 'bg-brand-50 text-brand-700 shadow-sm' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}">
                <i data-lucide="${item.icon}" class="w-5 h-5"></i>${item.label}
              </button>`).join('')}
          </nav>
          <div class="p-4 border-t border-slate-100">
            <div class="flex items-center gap-3 px-4 py-2">
              <div class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center">
                <span class="text-brand-700 text-sm font-bold">${(state.user?.name||'U')[0].toUpperCase()}</span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-slate-900 truncate">${state.user?.name||'User'}</p>
                <p class="text-xs text-slate-400 truncate">${state.user?.email||''}</p>
              </div>
              <button onclick="logout()" class="text-slate-400 hover:text-red-500 transition-colors" title="Logout">
                <i data-lucide="log-out" class="w-5 h-5"></i>
              </button>
            </div>
          </div>
        </aside>

        <!-- Mobile Bottom Nav -->
        <nav class="lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 z-50 px-2 py-1">
          <div class="flex justify-around">
            ${menuItems.slice(0,5).map(item=>`
              <button onclick="navigate('${item.id}')"
                class="flex flex-col items-center py-2 px-2 rounded-lg transition-all ${state.page===item.id?'text-brand-600':'text-slate-400'}">
                <i data-lucide="${item.icon}" class="w-5 h-5"></i>
                <span class="text-[10px] mt-0.5 font-medium">${item.label.split(' ')[0]}</span>
              </button>`).join('')}
            <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
              class="flex flex-col items-center py-2 px-2 text-slate-400">
              <i data-lucide="menu" class="w-5 h-5"></i>
              <span class="text-[10px] mt-0.5 font-medium">More</span>
            </button>
          </div>
        </nav>
        <div id="mobile-menu" class="hidden lg:hidden fixed inset-0 bg-black/50 z-50" onclick="this.classList.add('hidden')">
          <div class="absolute bottom-16 left-4 right-4 bg-white rounded-2xl shadow-2xl p-4 space-y-2" onclick="event.stopPropagation()">
            ${menuItems.map(item=>`
              <button onclick="navigate('${item.id}');document.getElementById('mobile-menu').classList.add('hidden')"
                class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${state.page===item.id?'bg-brand-50 text-brand-700':'text-slate-600 hover:bg-slate-50'}">
                <i data-lucide="${item.icon}" class="w-5 h-5"></i>${item.label}
              </button>`).join('')}
            <button onclick="logout()" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-red-500 hover:bg-red-50">
              <i data-lucide="log-out" class="w-5 h-5"></i>Logout
            </button>
          </div>
        </div>

        <!-- Main Content -->
        <main class="flex-1 lg:ml-64 pb-20 lg:pb-0">
          <div class="max-w-6xl mx-auto p-4 sm:p-6 lg:p-8">
            <div class="fade-in" id="page-content">${renderPage()}</div>
          </div>
        </main>
      </div>`;
    }

    function renderPage() {
      switch(state.page) {
        case 'profile': return renderProfile();
        case 'calories': return renderCalories();
        case 'weight': return renderWeight();
        case 'exercises': return renderExercises();
        case 'subscription': return renderSubscription();
        case 'trainer': return renderTrainer();
        default: return renderDashboard();
      }
    }

    // ========================================
    // DASHBOARD
    // ========================================
    function renderDashboard() {
      loadDashboardData();
      const d = state.data.dashboard || {};
      return `
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Dashboard</h1>
        <p class="text-slate-500 mt-1">Welcome back, ${state.user?.name||'User'}! Here's your fitness overview.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
          <div class="w-10 h-10 bg-orange-50 rounded-xl flex items-center justify-center mb-2"><i data-lucide="flame" class="w-5 h-5 text-accent-500"></i></div>
          <p class="text-2xl font-bold text-slate-900">${d.todayCalories||0}</p>
          <p class="text-xs text-slate-400 font-medium uppercase tracking-wider">Calories Today</p>
          ${d.targetCalories?`<div class="mt-2 bg-slate-100 rounded-full h-1.5"><div class="bg-accent-500 rounded-full h-1.5" style="width:${Math.min(100,((d.todayCalories||0)/d.targetCalories)*100)}%"></div></div><p class="text-[10px] text-slate-400 mt-1">of ${d.targetCalories} target</p>`:''}
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
          <div class="w-10 h-10 bg-brand-50 rounded-xl flex items-center justify-center mb-2"><i data-lucide="scale" class="w-5 h-5 text-brand-600"></i></div>
          <p class="text-2xl font-bold text-slate-900">${d.currentWeight||'--'}</p>
          <p class="text-xs text-slate-400 font-medium uppercase tracking-wider">Weight (kg)</p>
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
          <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center mb-2"><i data-lucide="activity" class="w-5 h-5 text-blue-500"></i></div>
          <p class="text-2xl font-bold text-slate-900">${d.bmi||'--'}</p>
          <p class="text-xs text-slate-400 font-medium uppercase tracking-wider">BMI</p>
          ${d.bmi?`<p class="text-[10px] mt-1 ${d.bmi<18.5?'text-yellow-500':d.bmi<25?'text-brand-500':d.bmi<30?'text-accent-500':'text-red-500'}">${d.bmi<18.5?'Underweight':d.bmi<25?'Normal':d.bmi<30?'Overweight':'Obese'}</p>`:''}
        </div>
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
          <div class="w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center mb-2"><i data-lucide="crown" class="w-5 h-5 text-purple-500"></i></div>
          <p class="text-2xl font-bold text-slate-900 capitalize">${d.subscription?.plan||'free'}</p>
          <p class="text-xs text-slate-400 font-medium uppercase tracking-wider">Plan</p>
        </div>
      </div>
      <div class="grid lg:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-4">Today's Macros</h3>
          <div class="space-y-3">
            <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-600">Protein</span><span class="font-semibold">${d.todayProtein||0}g</span></div><div class="bg-slate-100 rounded-full h-2"><div class="bg-blue-500 rounded-full h-2" style="width:${Math.min(100,((d.todayProtein||0)/150)*100)}%"></div></div></div>
            <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-600">Carbs</span><span class="font-semibold">${d.todayCarbs||0}g</span></div><div class="bg-slate-100 rounded-full h-2"><div class="bg-accent-500 rounded-full h-2" style="width:${Math.min(100,((d.todayCarbs||0)/250)*100)}%"></div></div></div>
            <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-600">Fat</span><span class="font-semibold">${d.todayFat||0}g</span></div><div class="bg-slate-100 rounded-full h-2"><div class="bg-brand-500 rounded-full h-2" style="width:${Math.min(100,((d.todayFat||0)/70)*100)}%"></div></div></div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
          <h3 class="text-lg font-bold text-slate-900 mb-4">Quick Actions</h3>
          <div class="grid grid-cols-2 gap-3">
            <button onclick="navigate('calories')" class="flex flex-col items-center gap-2 p-4 bg-orange-50 hover:bg-orange-100 rounded-xl transition-all"><i data-lucide="plus-circle" class="w-6 h-6 text-accent-500"></i><span class="text-sm font-medium text-slate-700">Log Meal</span></button>
            <button onclick="navigate('weight')" class="flex flex-col items-center gap-2 p-4 bg-brand-50 hover:bg-brand-100 rounded-xl transition-all"><i data-lucide="scale" class="w-6 h-6 text-brand-600"></i><span class="text-sm font-medium text-slate-700">Log Weight</span></button>
            <button onclick="navigate('exercises')" class="flex flex-col items-center gap-2 p-4 bg-blue-50 hover:bg-blue-100 rounded-xl transition-all"><i data-lucide="dumbbell" class="w-6 h-6 text-blue-500"></i><span class="text-sm font-medium text-slate-700">Exercises</span></button>
            <button onclick="navigate('profile')" class="flex flex-col items-center gap-2 p-4 bg-purple-50 hover:bg-purple-100 rounded-xl transition-all"><i data-lucide="user-circle" class="w-6 h-6 text-purple-500"></i><span class="text-sm font-medium text-slate-700">My Profile</span></button>
          </div>
        </div>
      </div>
      ${d.tdee?`
      <div class="bg-gradient-to-r from-brand-600 to-brand-700 rounded-2xl p-6 shadow-lg text-white">
        <h3 class="text-lg font-bold mb-3">Your Fitness Summary</h3>
        <div class="grid grid-cols-3 gap-4">
          <div><p class="text-brand-200 text-xs uppercase tracking-wider">BMR</p><p class="text-2xl font-bold">${d.bmr}</p><p class="text-brand-200 text-xs">cal/day at rest</p></div>
          <div><p class="text-brand-200 text-xs uppercase tracking-wider">TDEE</p><p class="text-2xl font-bold">${d.tdee}</p><p class="text-brand-200 text-xs">cal/day total</p></div>
          <div><p class="text-brand-200 text-xs uppercase tracking-wider">Target</p><p class="text-2xl font-bold">${d.targetCalories}</p><p class="text-brand-200 text-xs">cal/day goal</p></div>
        </div>
      </div>`:`
      <div class="bg-gradient-to-r from-slate-600 to-slate-700 rounded-2xl p-6 shadow-lg text-white">
        <div class="flex items-center gap-4">
          <i data-lucide="info" class="w-8 h-8 text-slate-300"></i>
          <div>
            <h3 class="text-lg font-bold">Complete Your Profile</h3>
            <p class="text-slate-300 text-sm">Fill in your details to get personalized BMI, BMR, TDEE, and calorie recommendations.</p>
            <button onclick="navigate('profile')" class="mt-3 bg-white text-slate-900 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-slate-100 transition-all">Update Profile →</button>
          </div>
        </div>
      </div>`}`;
    }

    async function loadDashboardData() {
      try {
        const data = await api('/user/stats');
        state.data.dashboard = data;
        const el = document.getElementById('page-content');
        if (el && state.page==='dashboard') { el.innerHTML=renderDashboard(); lucide.createIcons(); }
      } catch(err){}
    }

    // ========================================
    // PROFILE PAGE
    // ========================================
    function renderProfile() {
      loadProfileData();
      const u = state.data.profile?.user || state.user || {};
      return `
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Profile</h1>
        <p class="text-slate-500 mt-1">Update your information for personalized recommendations</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
          <form onsubmit="handleProfileUpdate(event)" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-4">
              <div><label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label><input type="text" id="prof-name" value="${u.name||''}" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none"></div>
              <div><label class="block text-sm font-medium text-slate-700 mb-1">Age</label><input type="number" id="prof-age" value="${u.age||''}" min="10" max="120" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none"></div>
