              <div class="text-center p-4 bg-slate-50 rounded-xl"><p class="text-sm text-slate-500 uppercase tracking-wider">BMI</p><p class="text-3xl font-bold text-slate-900">${state.data.profile?.bmi||'--'}</p><p class="text-xs text-slate-400 mt-1">${state.data.profile?.bmi?(state.data.profile.bmi<18.5?'Underweight':state.data.profile.bmi<25?'Normal / Fit':state.data.profile.bmi<30?'Overweight':'Obese'):'Complete profile'}</p></div>
              <div class="text-center p-4 bg-slate-50 rounded-xl"><p class="text-sm text-slate-500 uppercase tracking-wider">BMR</p><p class="text-3xl font-bold text-slate-900">${state.data.profile?.bmr||'--'}</p><p class="text-xs text-slate-400 mt-1">Cal/day at rest</p></div>
              <div class="text-center p-4 bg-slate-50 rounded-xl"><p class="text-sm text-slate-500 uppercase tracking-wider">TDEE</p><p class="text-3xl font-bold text-slate-900">${state.data.profile?.tdee||'--'}</p><p class="text-xs text-slate-400 mt-1">Cal/day total need</p></div>
