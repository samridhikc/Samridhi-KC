      try {
        const history = await api('/weight/history');
        state.data.weight = { history };
        const el = document.getElementById('page-content');
        if (el && state.page==='weight') { el.innerHTML=renderWeight(); lucide.createIcons(); renderWeightChart(history); }
      } catch(err){}
    }

    async function handleWeightLog(e) {
      e.preventDefault();
      try {
        await api('/weight/log','POST',{
          weight: parseFloat(document.getElementById('weight-val').value),
          date: document.getElementById('weight-date').value,
          note: document.getElementById('weight-note').value
        });
        showToast('Weight logged!');
