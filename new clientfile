    async function loadProfileData() {
      try {
        const data = await api('/user/stats');
        state.data.profile = data;
        const el = document.getElementById('page-content');
        if (el && state.page==='profile') { el.innerHTML=renderProfile(); lucide.createIcons(); }
      } catch(err){}
    }

    async function handleProfileUpdate(e) {
      e.preventDefault();
      const goalRadio = document.querySelector('input[name="goal"]:checked');
      const body = {
        name: document.getElementById('prof-name').value,
        age: parseInt(document.getElementById('prof-age').value)||undefined,
        gender: document.getElementById('prof-gender').value||undefined,
        weight: parseFloat(document.getElementById('prof-weight').value)||undefined,
        height: parseInt(document.getElementById('prof-height').value)||undefined,
        activityLevel: document.getElementById('prof-activity').value||undefined,
        fitnessGoal: goalRadio?goalRadio.value:undefined
      };
      try {
        const data = await api('/user/profile','PUT',body);
        state.data.profile = data;
        state.user.name = body.name;
        localStorage.setItem('fh_user',JSON.stringify(state.user));
        showToast('Profile updated!');
        render();
      } catch(err){}
    }

    // ========================================
    // CALORIE TRACKER
    // ========================================
    function renderCalories() {
      loadCalorieData();
      const d = state.data.calories || {};
      const log = d.todayLog || {meals:[],totalCalories:0,totalProtein:0,totalCarbs:0,totalFat:0};
      return `
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Calorie Tracker</h1>
        <p class="text-slate-500 mt-1">Track your daily meals and monitor calorie intake</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
          <div class="bg-gradient-to-r from-accent-500 to-accent-600 rounded-2xl p-6 shadow-lg text-white">
            <div class="flex items-center justify-between">
              <div><p class="text-orange-100 text-sm uppercase tracking-wider">Today's Intake</p><p class="text-4xl font-bold">${log.totalCalories}</p><p class="text-orange-100 text-sm mt-1">calories consumed</p></div>
              <div class="text-right space-y-1"><p class="text-sm"><span class="font-semibold">${log.totalProtein}g</span> protein</p><p class="text-sm"><span class="font-semibold">${log.totalCarbs}g</span> carbs</p><p class="text-sm"><span class="font-semibold">${log.totalFat}g</span> fat</p></div>
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-900 mb-4">Add Meal</h3>
            <div class="mb-4"><div class="relative"><i data-lucide="search" class="absolute left-3 top-3 w-5 h-5 text-slate-400"></i><input type="text" id="food-search" placeholder="Search foods..." oninput="searchFoods(this.value)" class="w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none"></div><div id="food-results" class="mt-2 max-h-48 overflow-y-auto"></div></div>
            <form onsubmit="handleAddMeal(event)" class="grid sm:grid-cols-2 gap-3">
              <input type="text" id="meal-name" placeholder="Food name" required class="px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
              <select id="meal-type" class="px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none bg-white"><option value="breakfast">Breakfast</option><option value="lunch">Lunch</option><option value="dinner">Dinner</option><option value="snack">Snack</option></select>
              <input type="number" id="meal-cal" placeholder="Calories" required min="0" class="px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
              <input type="number" id="meal-protein" placeholder="Protein (g)" min="0" step="0.1" class="px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
              <input type="number" id="meal-carbs" placeholder="Carbs (g)" min="0" step="0.1" class="px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
              <input type="number" id="meal-fat" placeholder="Fat (g)" min="0" step="0.1" class="px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
              <button type="submit" class="sm:col-span-2 bg-brand-600 hover:bg-brand-700 text-white py-2.5 rounded-xl font-semibold transition-all">+ Add Meal</button>
            </form>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-900 mb-4">Today's Meals</h3>
            ${log.meals.length===0?`<div class="text-center py-8 text-slate-400"><i data-lucide="utensils" class="w-12 h-12 mx-auto mb-2 opacity-50"></i><p>No meals logged today</p></div>`:`
            <div class="space-y-3">${log.meals.map(meal=>`
              <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
                <div class="flex items-center gap-3">
                  <span class="text-xs font-bold uppercase text-brand-600 bg-brand-50 px-2 py-1 rounded">${meal.mealType}</span>
                  <div><p class="text-sm font-medium text-slate-900">${meal.name}</p><p class="text-xs text-slate-400">P:${meal.protein}g C:${meal.carbs}g F:${meal.fat}g</p></div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-accent-500">${meal.calories} cal</span>
                  ${log._id?`<button onclick="deleteMeal('${log._id}','${meal._id}')" class="text-slate-300 hover:text-red-500 transition-colors"><i data-lucide="x" class="w-4 h-4"></i></button>`:''}
                </div>
              </div>`).join('')}</div>`}
          </div>
        </div>
        <div class="space-y-4">
          <button onclick="loadRecommendations()" class="w-full bg-white hover:bg-slate-50 rounded-2xl p-5 shadow-sm border border-slate-100 text-left transition-all">
            <div class="flex items-center gap-3"><div class="w-10 h-10 bg-brand-50 rounded-xl flex items-center justify-center"><i data-lucide="sparkles" class="w-5 h-5 text-brand-600"></i></div><div><p class="font-semibold text-slate-900">Get Recommendations</p><p class="text-xs text-slate-400">Personalized meal plan</p></div></div>
          </button>
          <div id="recommendations"></div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-sm font-bold text-slate-900 mb-3">7-Day Calorie History</h3>
            <canvas id="calorieChart" height="200"></canvas>
          </div>
        </div>
      </div>`;
    }

    async function loadCalorieData() {
      try {
        const [todayLog, history] = await Promise.all([api('/calories/today'), api('/calories/history')]);
        state.data.calories = { todayLog, history };
        const el = document.getElementById('page-content');
        if (el && state.page==='calories') { el.innerHTML=renderCalories(); lucide.createIcons(); renderCalorieChart(history); }
      } catch(err){}
    }

    async function searchFoods(query) {
      if (query.length<2) { document.getElementById('food-results').innerHTML=''; return; }
      try {
        const foods = await api(`/calories/foods?search=${encodeURIComponent(query)}`);
        const c = document.getElementById('food-results');
        if (!foods.length) { c.innerHTML='<p class="text-sm text-slate-400 p-2">No foods found</p>'; return; }
        c.innerHTML = foods.map(f=>`<button type="button" onclick="selectFood('${f.name.replace(/'/g,"\\'")}',${f.calories},${f.protein},${f.carbs},${f.fat})" class="w-full flex items-center justify-between p-2 hover:bg-brand-50 rounded-lg transition-colors text-left"><span class="text-sm text-slate-700">${f.name}</span><span class="text-xs text-slate-400">${f.calories} cal</span></button>`).join('');
      } catch(err){}
    }

    function selectFood(name,cal,p,c,f) {
      document.getElementById('meal-name').value=name;
      document.getElementById('meal-cal').value=cal;
      document.getElementById('meal-protein').value=p;
      document.getElementById('meal-carbs').value=c;
      document.getElementById('meal-fat').value=f;
      document.getElementById('food-results').innerHTML='';
    }

    async function handleAddMeal(e) {
      e.preventDefault();
      try {
        await api('/calories/log','POST',{
          name: document.getElementById('meal-name').value,
          calories: parseInt(document.getElementById('meal-cal').value),
          protein: parseFloat(document.getElementById('meal-protein').value)||0,
          carbs: parseFloat(document.getElementById('meal-carbs').value)||0,
          fat: parseFloat(document.getElementById('meal-fat').value)||0,
          mealType: document.getElementById('meal-type').value
        });
        showToast('Meal logged!');
        loadCalorieData();
      } catch(err){}
    }

    async function deleteMeal(logId,mealId) {
      try { await api(`/calories/meal/${logId}/${mealId}`,'DELETE'); showToast('Meal removed'); loadCalorieData(); } catch(err){}
    }

    async function loadRecommendations() {
      try {
        const data = await api('/calories/recommend');
        const c = document.getElementById('recommendations');
        const m = data.meals;
        c.innerHTML=`<div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 fade-in">
          <h3 class="text-sm font-bold text-slate-900 mb-1">Recommended Plan</h3>
          <p class="text-xs text-slate-400 mb-4">Target: ${data.targetCalories} cal/day</p>
          ${['breakfast','lunch','dinner','snack'].map(t=>`<div class="mb-3"><p class="text-xs font-bold uppercase text-brand-600 mb-1">${t} (${m[t].calorieTarget} cal)</p>${m[t].foods.map(f=>`<p class="text-xs text-slate-600 pl-2">• ${f.name} <span class="text-slate-400">(${f.calories}cal)</span></p>`).join('')}</div>`).join('')}
        </div>`;
        lucide.createIcons();
      } catch(err){}
    }

    function renderCalorieChart(history) {
      const canvas = document.getElementById('calorieChart');
      if (!canvas) return;
      const last7 = history.slice(0,7).reverse();
      new Chart(canvas, {
        type:'bar',
        data:{ labels:last7.map(l=>new Date(l.date).toLocaleDateString('en',{month:'short',day:'numeric'})), datasets:[{label:'Calories',data:last7.map(l=>l.totalCalories),backgroundColor:'#f97316',borderRadius:6}] },
        options:{ responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,grid:{color:'#f1f5f9'}},x:{grid:{display:false}}} }
      });
    }

    // ========================================
    // WEIGHT TRACKER
    // ========================================
    function renderWeight() {
      loadWeightData();
      const d = state.data.weight || {};
      const history = d.history || [];
      return `
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Weight Tracker</h1>
        <p class="text-slate-500 mt-1">Monitor your weight progress over time</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-4">
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-900 mb-4">Weight Progress</h3>
            <canvas id="weightChart" height="250"></canvas>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-900 mb-4">Weight History</h3>
            ${history.length===0?`<div class="text-center py-8 text-slate-400"><i data-lucide="bar-chart-3" class="w-12 h-12 mx-auto mb-2 opacity-50"></i><p>No weight entries yet</p></div>`:`
