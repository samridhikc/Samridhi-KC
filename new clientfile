        </select>
        <select id="ex-diff" onchange="loadExercises()" class="px-4 py-2 border border-slate-200 rounded-xl bg-white text-sm focus:ring-2 focus:ring-brand-500 outline-none">
          <option value="">All Levels</option><option value="beginner">Beginner</option><option value="intermediate">Intermediate</option><option value="advanced">Advanced</option>
        </select>
        <select id="ex-type" onchange="loadExercises()" class="px-4 py-2 border border-slate-200 rounded-xl bg-white text-sm focus:ring-2 focus:ring-brand-500 outline-none">
          <option value="">All Types</option><option value="strength">Strength</option><option value="cardio">Cardio</option><option value="flexibility">Flexibility</option>
        </select>
      </div>
      ${exercises.length===0?`<div class="text-center py-12 text-slate-400"><i data-lucide="dumbbell" class="w-12 h-12 mx-auto mb-2 opacity-50"></i><p>Loading exercises...</p></div>`:`
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        ${exercises.map(ex=>`
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100 hover:shadow-lg transition-all cursor-pointer" onclick="showExerciseDetail('${ex._id}')">
          <div class="h-40 bg-slate-200 relative overflow-hidden">
            <img src="${ex.image}" alt="${ex.name}" class="w-full h-full object-cover" onerror="this.src='https://picsum.photos/seed/${ex.name.replace(/ /g,'')}/400/300.jpg'">
            <div class="absolute top-3 right-3 flex gap-1">
              <span class="text-[10px] font-bold uppercase px-2 py-1 rounded-full ${ex.difficulty==='beginner'?'bg-brand-100 text-brand-700':ex.difficulty==='intermediate'?'bg-yellow-100 text-yellow-700':'bg-red-100 text-red-700'}">${ex.difficulty}</span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-slate-900 mb-1">${ex.name}</h3>
            <p class="text-xs text-slate-500 mb-3 line-clamp-2">${ex.description}</p>
            <div class="flex items-center gap-3 text-xs text-slate-400">
              <span class="flex items-center gap-1"><i data-lucide="clock" class="w-3 h-3"></i>${ex.duration} min</span>
              <span class="flex items-center gap-1"><i data-lucide="flame" class="w-3 h-3"></i>${ex.caloriesBurned} cal</span>
              <span class="flex items-center gap-1"><i data-lucide="target" class="w-3 h-3"></i>${ex.targetMuscle}</span>
            </div>
          </div>
        </div>`).join('')}
      </div>`}
      <div id="exercise-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" onclick="this.classList.add('hidden')">
        <div class="bg-white rounded-2xl max-w-lg w-full max-h-[80vh] overflow-y-auto p-6" onclick="event.stopPropagation()" id="exercise-modal-content"></div>
      </div>`;
    }

    async function loadExercises() {
      const goal = document.getElementById('ex-goal')?.value||'';
      const diff = document.getElementById('ex-diff')?.value||'';
      const type = document.getElementById('ex-type')?.value||'';
      try {
        let url = '/exercises?';
        if (goal) url += `goal=${goal}&`;
        if (diff) url += `difficulty=${diff}&`;
        if (type) url += `type=${type}&`;
        const list = await api(url);
        state.data.exercises = { list };
        const el = document.getElementById('page-content');
        if (el && state.page==='exercises') { el.innerHTML=renderExercises(); lucide.createIcons(); }
      } catch(err){}
    }

    async function showExerciseDetail(id) {
      try {
        const ex = await api(`/exercises/${id}`);
        const modal = document.getElementById('exercise-modal');
        const content = document.getElementById('exercise-modal-content');
        content.innerHTML = `
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-slate-900">${ex.name}</h2>
            <button onclick="document.getElementById('exercise-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
          </div>
          <img src="${ex.image}" alt="${ex.name}" class="w-full h-48 object-cover rounded-xl mb-4" onerror="this.src='https://picsum.photos/seed/${ex.name.replace(/ /g,'')}/400/300.jpg'">
          <p class="text-slate-600 text-sm mb-4">${ex.description}</p>
          <div class="grid grid-cols-3 gap-3 mb-4">
            <div class="text-center p-3 bg-slate-50 rounded-xl"><p class="text-lg font-bold text-slate-900">${ex.duration}</p><p class="text-xs text-slate-400">Minutes</p></div>
            <div class="text-center p-3 bg-slate-50 rounded-xl"><p class="text-lg font-bold text-slate-900">${ex.caloriesBurned}</p><p class="text-xs text-slate-400">Calories</p></div>
            <div class="text-center p-3 bg-slate-50 rounded-xl"><p class="text-lg font-bold text-slate-900 capitalize">${ex.difficulty}</p><p class="text-xs text-slate-400">Level</p></div>
          </div>
          <div class="flex gap-2 mb-4">
            <span class="text-xs font-medium bg-brand-50 text-brand-700 px-3 py-1 rounded-full">${ex.targetMuscle}</span>
            <span class="text-xs font-medium bg-blue-50 text-blue-700 px-3 py-1 rounded-full capitalize">${ex.type}</span>
            <span class="text-xs font-medium bg-purple-50 text-purple-700 px-3 py-1 rounded-full capitalize">${ex.goal} weight</span>
          </div>
          <h3 class="font-bold text-slate-900 mb-3">Step-by-Step Instructions</h3>
          <ol class="space-y-3">${ex.steps.map((s,i)=>`<li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 bg-brand-600 text-white text-xs font-bold rounded-full flex items-center justify-center">${i+1}</span><span class="text-sm text-slate-600 pt-0.5">${s}</span></li>`).join('')}</ol>`;
        modal.classList.remove('hidden');
        lucide.createIcons();
      } catch(err){}
    }

    // ========================================
    // SUBSCRIPTION PAGE
    // ========================================
    function renderSubscription() {
      loadSubscriptionData();
      const d = state.data.subscription || {};
      const plans = d.plans || {};
      const current = d.current || { plan:'free',status:'active' };
      return `
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Subscription</h1>
        <p class="text-slate-500 mt-1">Choose a plan that fits your fitness journey</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        ${['free','premium','pro'].map(planKey => {
          const p = plans[planKey] || { name:planKey, price:planKey==='premium'?999:planKey==='pro'?1999:0, features:planKey==='free'?['Basic calorie tracking','Weight logging','Limited exercises']:planKey==='premium'?['Advanced calorie tracking','Food recommendations','All exercises','Progress graphs','Trainer chat']:['Everything in Premium','1-on-1 trainer sessions','Custom meal plans','Priority support','Video tutorials'] };
          const isCurrent = current.plan === planKey;
          const isPopular = planKey === 'premium';
          return `
          <div class="relative bg-white rounded-2xl p-6 shadow-sm border ${isPopular?'border-brand-500 ring-2 ring-brand-100':'border-slate-100'} ${isCurrent?'opacity-75':''}">
            ${isPopular?'<div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-600 text-white text-xs font-bold px-4 py-1 rounded-full">Most Popular</div>':''}
            <h3 class="text-xl font-bold text-slate-900 capitalize mb-1">${p.name}</h3>
            <div class="mb-4"><span class="text-3xl font-bold text-slate-900">Rs. ${p.price}</span><span class="text-slate-400 text-sm">/month</span></div>
            <ul class="space-y-2 mb-6">${p.features.map(f=>`<li class="flex items-center gap-2 text-sm text-slate-600"><i data-lucide="check" class="w-4 h-4 text-brand-500 flex-shrink-0"></i>${f}</li>`).join('')}</ul>
            ${isCurrent?`<button disabled class="w-full py-3 rounded-xl font-semibold bg-slate-100 text-slate-400 cursor-not-allowed">Current Plan</button>`
            :`<button onclick="handleSubscribe('${planKey}')" class="w-full py-3 rounded-xl font-semibold transition-all ${isPopular?'bg-brand-600 hover:bg-brand-700 text-white shadow-lg hover:shadow-xl':'bg-slate-100 hover:bg-slate-200 text-slate-700'}">${planKey==='free'?'Downgrade':'Subscribe Now'}</button>`}
          </div>`;
        }).join('')}
      </div>
      <div class="mt-8 bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
        <h3 class="text-lg font-bold text-slate-900 mb-4">Subscription Status</h3>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center"><i data-lucide="shield-check" class="w-6 h-6 text-brand-600"></i></div>
          <div>
            <p class="font-semibold text-slate-900 capitalize">${current.plan} Plan</p>
            <p class="text-sm text-slate-400">Status: <span class="capitalize ${current.status==='active'?'text-brand-600':'text-red-500'}">${current.status}</span></p>
            ${current.endDate?`<p class="text-sm text-slate-400">Valid until: ${new Date(current.endDate).toLocaleDateString()}</p>`:''}
          </div>
        </div>
      </div>`;
    }

    async function loadSubscriptionData() {
      try {
        const [plans, current] = await Promise.all([api('/subscription/plans'), api('/subscription/current')]);
        state.data.subscription = { plans, current };
        const el = document.getElementById('page-content');
        if (el && state.page==='subscription') { el.innerHTML=renderSubscription(); lucide.createIcons(); }
      } catch(err){}
    }

    async function handleSubscribe(plan) {
      if (!confirm(`Subscribe to ${plan} plan? (Mock payment - no real charge)`)) return;
      try {
        await api('/subscription/subscribe','POST',{ plan, paymentMethod:'mock' });
        showToast(`Subscribed to ${plan} plan!`);
        loadSubscriptionData();
      } catch(err){}
    }

    // ========================================
    // TRAINER CHAT PAGE
    // ========================================
    function renderTrainer() {
      loadTrainerData();
      const d = state.data.trainer || {};
      const trainers = d.trainers || [];
      const messages = d.messages || [];
      const selectedTrainer = d.selectedTrainer || null;
      return `
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Trainer Chat</h1>
        <p class="text-slate-500 mt-1">Get personalized guidance from our trainers</p>
      </div>
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="space-y-3">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Available Trainers</h3>
          ${trainers.length===0?`<div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 text-center text-slate-400"><p>No trainers available yet. Run the seed script!</p><p class="text-xs mt-1">npm run seed</p></div>`:
          trainers.map(t=>`
          <button onclick="selectTrainer('${t._id}')"
            class="w-full flex items-center gap-3 p-4 bg-white rounded-xl shadow-sm border ${selectedTrainer===t._id?'border-brand-500 ring-2 ring-brand-100':'border-slate-100'} hover:shadow-md transition-all text-left">
            <div class="w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center"><span class="text-brand-700 font-bold">${t.name[0]}</span></div>
            <div><p class="font-medium text-slate-900">${t.name}</p><p class="text-xs text-slate-400">Fitness Trainer</p></div>
          </button>`).join('')}
        </div>
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 flex flex-col" style="min-height:400px">
          <div class="p-4 border-b border-slate-100">
            <h3 class="font-bold text-slate-900">${selectedTrainer?trainers.find(t=>t._id===selectedTrainer)?.name||'Trainer':'Select a trainer'}</h3>
            <p class="text-xs text-slate-400">${selectedTrainer?'Online':'Choose a trainer to start chatting'}</p>
          </div>
          <div class="flex-1 p-4 space-y-3 overflow-y-auto chat-messages" id="chat-messages">
            ${messages.length===0?`<div class="text-center py-12 text-slate-400"><i data-lucide="message-circle" class="w-12 h-12 mx-auto mb-2 opacity-50"></i><p>${selectedTrainer?'No messages yet. Say hello!':'Select a trainer to begin'}</p></div>`:
            messages.map(m=>`
            <div class="flex ${m.senderId===state.user.id?'justify-end':'justify-start'}">
              <div class="max-w-xs px-4 py-2 rounded-2xl text-sm ${m.senderId===state.user.id?'bg-brand-600 text-white rounded-br-md':'bg-slate-100 text-slate-800 rounded-bl-md'}">
                <p>${m.message}</p>
                <p class="text-[10px] ${m.senderId===state.user.id?'text-brand-200':'text-slate-400'} mt-1">${new Date(m.createdAt).toLocaleTimeString('en',{hour:'2-digit',minute:'2-digit'})}</p>
              </div>
            </div>`).join('')}
          </div>
          ${selectedTrainer?`
          <form onsubmit="handleSendMessage(event)" class="p-4 border-t border-slate-100 flex gap-2">
            <input type="text" id="chat-input" placeholder="Type your message..." required
              class="flex-1 px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none">
            <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2.5 rounded-xl font-semibold transition-all">
              <i data-lucide="send" class="w-5 h-5"></i>
            </button>
          </form>`:''}
        </div>
      </div>`;
    }

    async function loadTrainerData() {
      try {
        const trainers = await api('/trainer/trainers');
        state.data.trainer = { ...(state.data.trainer||{}), trainers };
        const el = document.getElementById('page-content');
        if (el && state.page==='trainer') { el.innerHTML=renderTrainer(); lucide.createIcons(); scrollChat(); }
      } catch(err){}
    }

    async function selectTrainer(trainerId) {
      try {
        const messages = await api(`/trainer/messages/${trainerId}`);
        state.data.trainer = { ...(state.data.trainer||{}), selectedTrainer: trainerId, messages };
        const el = document.getElementById('page-content');
        if (el && state.page==='trainer') { el.innerHTML=renderTrainer(); lucide.createIcons(); scrollChat(); }
      } catch(err){}
    }

    async function handleSendMessage(e) {
      e.preventDefault();
      const trainerId = state.data.trainer?.selectedTrainer;
      if (!trainerId) return;
      const input = document.getElementById('chat-input');
      try {
        await api('/trainer/message','POST',{ receiverId:trainerId, message:input.value });
        input.value='';
        selectTrainer(trainerId);
      } catch(err){}
    }

    function scrollChat() {
      const el = document.getElementById('chat-messages');
      if (el) el.scrollTop = el.scrollHeight;
    }

    // ========================================
    // CHART INITIALIZATION
    // ========================================
    function initCharts() {
      // Charts are initialized within their respective load functions
    }

    // ========================================
    // BOOTSTRAP - Start the app
    // ========================================
    render();
  </script>
</body>
</html>
