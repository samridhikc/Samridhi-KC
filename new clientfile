        options:{ responsive:true, plugins:{legend:{display:false}}, scales:{y:{grid:{color:'#f1f5f9'}},x:{grid:{display:false}}} }
      });
    }

    // ========================================
    // EXERCISES PAGE
    // ========================================
    function renderExercises() {
      loadExercises();
      const d = state.data.exercises || {};
      const exercises = d.list || [];
      return `
      <div class="mb-8">
