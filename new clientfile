                <label class="flex-1 cursor-pointer"><input type="radio" name="goal" value="gain" ${u.fitnessGoal==='gain'?'checked':''} class="hidden peer"><div class="peer-checked:bg-blue-50 peer-checked:border-blue-500 peer-checked:text-blue-700 border-2 border-slate-200 rounded-xl p-3 text-center text-sm font-medium text-slate-500 transition-all hover:border-slate-300"><i data-lucide="trending-up" class="w-5 h-5 mx-auto mb-1"></i>Gain Weight</div></label>
